# SPA rewrite for Hostinger (LiteSpeed honors Apache .htaccess).
#
# Without this, any deep link like /login, /dashboard, /dashboard/jobs would
# 404 because Hostinger looks for a literal file at that path. With this rule
# every request that doesn't match an existing file or directory is rewritten
# to /index.html, where React Router can pick it up client-side. The Google
# OAuth callback at /login?code=... was the symptom; this is the fix.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve real files and directories as-is (assets, favicon, etc.).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else falls through to the SPA shell.
  RewriteRule ^ index.html [L]
</IfModule>

# Long-cache the hashed assets Vite emits (they have content hashes in the
# filename — safe to cache for a year). The HTML shell itself stays uncached
# so a deploy is immediately visible.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|woff|ttf|eot|svg|png|jpg|jpeg|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
